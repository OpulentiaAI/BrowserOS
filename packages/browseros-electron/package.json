{
  "name": "opulent-browser",
  "version": "0.1.0",
  "description": "Opulent Browser - AI-powered browsing with native sidebar",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron . --inspect",
    "build:sidebar": "webpack --config webpack.sidebar.js",
    "build:sidebar:watch": "webpack --config webpack.sidebar.js --watch",
    "build:app": "npm run build:sidebar && electron-builder",
    "build:mac": "npm run build:sidebar && electron-builder --mac",
    "build:win": "npm run build:sidebar && electron-builder --win",
    "build:linux": "npm run build:sidebar && electron-builder --linux",
    "build:all": "npm run build:sidebar && electron-builder -mwl",
    "clean": "rimraf dist sidebar/dist"
  },
  "author": "OpulentiaAI",
  "license": "AGPL-3.0",
  "dependencies": {
    "electron": "^28.0.0",
    "@ai-sdk/anthropic": "^1.0.12",
    "@ai-sdk/openai": "^1.0.14",
    "@ai-sdk/google": "^1.0.9",
    "ai": "^6.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "markdown-to-jsx": "^7.7.12",
    "electron-store": "^8.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "postcss": "^8.4.34",
    "postcss-loader": "^7.3.3",
    "tailwindcss": "^3.4.4",
    "autoprefixer": "^10.4.21",
    "rimraf": "^6.0.1"
  },
  "build": {
    "appId": "com.opulentiaai.browser",
    "productName": "Opulent Browser",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "sidebar/dist/**/*",
      "sidebar/index.html",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb", "snap"],
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  }
}
